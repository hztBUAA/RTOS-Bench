from building import *
import os

cwd = GetCurrentDir()

# ------------------------------------------------------------------
# 1. 收集源文件
# ------------------------------------------------------------------
# 将 'app_modbus.c' 替换为你实际保存的文件名
# 如果该目录下有多个 C 文件都需要编译，可以使用 src = Glob('*.c')
src = Glob('*.c')

# ------------------------------------------------------------------
# 2. 头文件路径
# ------------------------------------------------------------------
# 将当前目录加入头文件搜索路径，以便编译器能找到 "nanomodbus.h"
CPPPATH = [
    cwd,
]

# ------------------------------------------------------------------
# 3. 宏定义
# ------------------------------------------------------------------
CPPDEFINES = [
]

# ------------------------------------------------------------------
# 4. 定义构建组
# ------------------------------------------------------------------
# 这里的 'MB_Bench' 是在 IDE 或 map 文件中显示的组名
group = DefineGroup('MQTT_Bench', src,
                    depend = [''],
                    CPPPATH = CPPPATH,
                    CPPDEFINES = CPPDEFINES)

Return('group')