# CONFIG_RT_USING_NOHEAP is not set
# CONFIG_RT_USING_MEMTRACE is not set
CONFIG_RT_USING_HEAP_ISR=y
CONFIG_RT_USING_HEAP=y
# end of Memory Management

CONFIG_RT_USING_DEVICE=y
