# RTOS-Bench Generator SConscript
from building import *
import os

cwd = GetCurrentDir()

# 检测平台
# RT-Thread detection: check for RT_THREAD_PRIORITY_MAX which is always defined
if GetDepend(['ONEOS_PLATFORM']):
    platform = 'oneos'
elif GetDepend(['RUIHUA_PLATFORM']) or GetDepend(['__REWORKS__']):
    platform = 'ruihua'
elif GetDepend(['RT_THREAD_PRIORITY_32']) or GetDepend(['RT_THREAD_PRIORITY_256']):
    platform = 'rt-thread'
elif GetDepend(['RT_USING_LIBC']):
    platform = 'rt-thread'
else:
    platform = 'posix-lite'

# Core source files (platform-agnostic)
src_files = [
    'periodic_benchmark.c',
    'logging.c',
    'memory_watcher.c',
    'workload_registry.c',
    'workload_stub.c',
    'workload_busywait.c',
    'uunifast.c',
    'test_schedule.c',
    'test_realtime.c',
    'test_stress.c',
    'test_cmd.c',
    'result_export.c',
    'rtbench_command.c',
]

# Add platform-specific entry and sources
if platform == 'rt-thread':
    src_files.append('rtthread_entry.c')
    src_files.append('rtthread_fini_stub.c')
elif platform == 'oneos':
    src_files.append('oneos_entry.c')
elif platform == 'ruihua':
    src_files.append('ruihua_entry.c')
else:
    # posix-lite or Linux
    src_files.append('posixlite_entry.c')

# Convert to File objects
src = [File(f) for f in src_files]

# Add platform abstraction layer
src += Glob('platform/' + platform + '/*.c')
src += Glob('test_schedule/*.c')

# Add original realtime tests (les, realtime, multicore)
src += Glob('realtime_orig/les/*.c')
src += Glob('realtime_orig/realtime/*.c')
src += Glob('realtime_orig/multicore/*.c')
src += Glob('realtime_orig/verify/*.c')

# Add stress-ng port (stress_orig)
src += [File('stress_orig/stress_bench.c')]
src += [File('stress_orig/common/stress-ng.c')]
src += [File('stress_orig/common/core-helper.c')]
src += [File('stress_orig/common/stress_stored_job.c')]
# Only include platform-specific OSAL (avoid compiling SylixOS OSAL on RT-Thread)
if platform == 'rt-thread':
    src += [File('stress_orig/osal/os_rtt.c')]
else:
    src += Glob('stress_orig/osal/*.c')
src += Glob('stress_orig/stressor/*.c')

CPPPATH = [cwd, cwd + '/realtime_orig/les', cwd + '/stress_orig', cwd + '/stress_orig/common', cwd + '/stress_orig/osal']
LOCAL_CPPDEFINES = []

# RT-Thread 平台特殊处理
if platform == 'rt-thread':
    LOCAL_CPPDEFINES.append('RT_THREAD_PLATFORM')
elif platform == 'ruihua':
    LOCAL_CPPDEFINES.append('RUIHUA_PLATFORM')

# OneOS 平台特殊处理
LOCAL_CCFLAGS = ''
if platform == 'oneos':
    include_dir = os.path.join(cwd, 'platform', 'oneos', 'include')
    CPPPATH.insert(0, include_dir)  # Shadow headers must be first
    sched_adapter_h = os.path.join(include_dir, 'posix_sched_adapter.h')
    LOCAL_CCFLAGS = ' -include ' + sched_adapter_h

group = DefineGroup('rtbench_generator', src,
                    depend=[''],
                    CPPPATH=CPPPATH,
                    LOCAL_CCFLAGS=LOCAL_CCFLAGS,
                    LOCAL_CPPDEFINES=LOCAL_CPPDEFINES)

Return('group')
