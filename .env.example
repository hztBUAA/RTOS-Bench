# RTOS-Bench Result Flow / Data Process upload settings.
# Copy this file to .env and fill the credential values locally.

# Shared platform endpoint.
RTBENCH_FLOW_BASE_URL=http://101.37.88.128:30000
RTBENCH_DATA_PROCESS_BASE_URL=http://101.37.88.128:30000

# Flow/Kamala XML file upload API credentials.
RTBENCH_FLOW_API_KEY=<your-api-key>
RTBENCH_FLOW_SECRET_KEY=<your-secret-key>

# Data Process OpenAPI credentials. If both platforms use the same credential,
# keep these values identical to the Flow credential in your local .env.
RTBENCH_DATA_PROCESS_API_KEY=<your-api-key>
RTBENCH_DATA_PROCESS_SECRET_KEY=<your-secret-key>

# Flow upload metadata.
RTBENCH_FLOW_UPLOAD_PATH=rtbench-results
RTBENCH_FLOW_POD_NAME=<flow-pod-name>

# Data Process index targets. Comma-separated when multiple datasets are needed.
RTBENCH_DATA_PROCESS_DATASET_KEYS=performance_safety

# Optional: set this only when the platform side requires a fixed document ID.
# RTBENCH_DATA_PROCESS_BIZ_ID=<custom-biz-id>
